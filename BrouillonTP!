    // Helper method: read a single character answer O/N //(case-insensitive) with validation (Exemple gave by AI)
    private static char lireOuiNon(String prompt) {
        char reponse;
        do {
            System.out.print(prompt);
            reponse = Clavier.lireCharLn();
            reponse = Character.toUpperCase(reponse);
            if (reponse != 'O' && reponse != 'N') {
                System.out.println(MSG_ON_ERR);
            }
        } while (reponse != 'O' && reponse != 'N');
        return reponse;
    }

    // Helper method: compute tax with rounding to 2 decimals //(Exemple gave by AI June)
    private static double calculerTaxeArrondie(double montant, double tauxPourcent) {
        double taxe = montant * tauxPourcent / 100.0;
        return Math.round(taxe * 100.0) / 100.0; // arrondi standard à 2 décimales
    }

